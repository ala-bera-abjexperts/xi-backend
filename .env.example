# Server
PORT=3001
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URLs used to build OAuth callbacks and email links
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001/api/v1

# Supabase (remote project)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=__SET_ME__
SUPABASE_SERVICE_ROLE_KEY=__SET_ME__
SUPABASE_JWT_SECRET=__SET_ME__

# Cookies
# Local dev across :3000/:3001 on localhost — leave domain blank, sameSite=lax, secure=false.
# Production cross-subdomain (e.g. app.xisuite.cloud → api.xisuite.cloud):
#   COOKIE_DOMAIN=.xisuite.cloud   (leading dot = match all subdomains)
#   COOKIE_SAMESITE=none           (required for cross-site cookie delivery)
#   COOKIE_SECURE=true             (mandatory whenever sameSite=none)
# Production same-origin reverse-proxy: keep sameSite=lax + secure=true.
# The resolved config is printed at boot — grep for "[cookies]" to verify.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_ACCESS_MAXAGE=3600
COOKIE_REFRESH_MAXAGE=604800

# Sessions
# >= 32 chars. Rotate per environment.
SESSION_SIGNING_SECRET=__SET_ME_TO_A_RANDOM_32_CHAR_STRING__

# Throttler / Rate Limiting
# Window (ms) and max requests per window per tracker key. The tracker key is
# per-user when the request carries a JWT, per-IP otherwise. Per-route
# @Throttle decorators override these globals (see auth.controller, etc.).
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Trust-proxy hop count for resolving req.ip (the per-IP tracker for anonymous
# traffic). 0 = ignore X-Forwarded-For (local dev). 1 = single reverse proxy
# in front of the app (typical Vercel/Nginx/ALB setup). Higher = more trusted
# hops — only raise this if you actually have a chain (CloudFront → ALB → app).
# Setting too high lets clients spoof their IP via X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Passkey authentication (disabled until Supabase Auth RP settings are enabled).
# Browser WebAuthn requests are accepted only from this exact canonical origin.
PASSKEY_AUTH_ENABLED=false
PASSKEY_ORIGIN=https://auth.lvh.me:3000
# Dedicated >=32-character HMAC secret. Never reuse a JWT, SMTP, or OAuth secret.
PASSKEY_TRUSTED_DEVICE_SECRET=__SET_ME_TO_A_RANDOM_32_CHAR_STRING__
# Optional proxy-owned ISO-country header. The edge MUST strip client values and set it itself.
PASSKEY_COUNTRY_HEADER=x-vercel-ip-country
PASSKEY_TRUSTED_DEVICE_TTL_DAYS=90
PASSKEY_RECENT_TOTP_SECONDS=600

# Mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_FROM=no-reply@example.com
EMAIL_PASS=__SET_ME__
# Auth username when the relay's login differs from EMAIL_FROM (defaults to EMAIL_FROM).
# SMTP_USER=relay-user@example.com
# LAST RESORT: disable relay TLS-chain verification (true/false; default: verify in
# production). Prefer trusting the relay/firewall CA via NODE_EXTRA_CA_CERTS —
# on-prem that is ./certs/extra-ca.pem in the deploy repo. 'false' logs a loud
# boot warning; the connection becomes open to man-in-the-middle.
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# MCP service-to-service (S2S) auth
# Dedicated HMAC secret used to verify the short-lived JWT the MCP server
# (xisuite-mcp) presents in the X-MCP-S2S-Authorization header. Must be the same
# value in both repos for local/dev. >= 32 chars. Never reuse SUPABASE_JWT_SECRET.
# Optional in dev (the backend boots without it; S2S calls are then rejected).
# In production its absence only logs a warning (S2S calls 401 until set).
# The value below must match xisuite-mcp's MCP_S2S_SIGNING_SECRET dev default, or
# every local S2S call 401s. Rotate to a strong random secret in production.
MCP_S2S_SIGNING_SECRET=local-dev-mcp-s2s-secret-0123456789abcdef

# Optional shared secret for the workflow git triggers. When set, the native
# GitHub webhook receiver (POST /api/v1/git-triggers/github/events) and the
# generic /git-triggers/branch-created + /pr-merged endpoints require and verify
# an HMAC signature. Set the SAME value in the GitHub webhook's "Secret" field so
# hand-made / org-scoped hooks (which the app cannot auto-register) can authenticate.
# Leave unset to keep the current behavior (only app-registered per-repo secrets).
WORKFLOW_GIT_TRIGGER_SECRET=
MCP_S2S_ISSUER=xisuite-mcp
MCP_S2S_AUDIENCE=xisuite-backend
MCP_S2S_CLOCK_SKEW_SECONDS=5

# Site Studio custom-domain TLS provisioning (Vercel API)
# PRODUCTION CLOUD ONLY — set in the VPS .env next to docker-compose.yml, then
# `docker compose up -d` (restart alone does NOT reload env_file). When set,
# verified custom domains are attached to the Vercel project automatically
# (verify-time + 5-min background sweep) and certificates issue hands-off.
# Unset (dev/on-prem): provisioning no-ops; verification still works.
# DO NOT set in local dev — a local Verify would attach test domains to the
# real production Vercel project.
# VERCEL_TOKEN=            # vercel.com → Account Settings → Tokens (team scope)
# VERCEL_PROJECT_ID=       # the FRONTEND project → Settings → General
# VERCEL_TEAM_ID=          # only for team-scoped projects



AUTOMATIONS_PUBLIC_API_URL=http://localhost:3001/api/v1

# On-premise upload ceiling (BYTES) — only read when IS_ON_PREMISE=true (rendered
# into backend.env by the on-prem deployer, never set here). Overrides the 5 GB
# default for heavy-file uploads; the operator picks the ceiling for their own
# hardware. Unset or invalid falls back to 5 GB. Values past ~4 GiB only work on
# streaming surfaces (migration attachment import, File Explorer); the storage
# FILE_SIZE_LIMIT and any proxy body limits must be raised to match.
# ON_PREM_MAX_UPLOAD_BYTES=5368709120

# Azure DevOps Repos: a multi-tenant Microsoft Entra app (read scopes only). Connect stays disabled until both are set.
AZURE_DEVOPS_CLIENT_ID=
AZURE_DEVOPS_CLIENT_SECRET=
