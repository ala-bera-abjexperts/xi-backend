{{!--
  Base email layout. Every template renders inside it via {{#> layout}} ... {{/layout}}.
  The {{> @partial-block}} slot receives the template's body sections.
  Design: a white card (rounded, 3px brand top-border) centered on a soft grey canvas.
--}}
<mjml>
  <mj-head>
    {{> head}}
  </mj-head>
  <mj-body background-color="#F5F5F9" width="600px">
    <mj-section padding="0">
      <mj-column>
        <mj-spacer height="32px" />
      </mj-column>
    </mj-section>

    <mj-wrapper
      background-color="#ffffff"
      border-radius="8px"
      padding="0"
      css-class="x-card"
    >
      <mj-section background-color="{{brand.primaryColor}}" border-radius="8px 8px 0 0" padding="0">
        <mj-column>
          <mj-spacer height="4px" />
        </mj-column>
      </mj-section>
      {{> header}}
      {{> @partial-block}}
      {{> footer}}
    </mj-wrapper>

    <mj-section padding="18px 24px 36px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9AA4B2" line-height="1.6">
          {{t 'footer.sentBy' app=brand.appName}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
