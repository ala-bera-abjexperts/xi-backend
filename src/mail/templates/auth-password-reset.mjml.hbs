{{!-- Password reset. data: { name, ctaUrl, preheader } --}}
{{#> layout}}
  {{> heading eyebrow=(t 'auth.reset.eyebrow') title=(t 'auth.reset.title')}}
  <mj-section padding="2px 32px 4px">
    <mj-column>
      <mj-text padding="0 0 12px">{{t 'auth.reset.greeting' name=(fallback data.name 'there')}}</mj-text>
      <mj-text>{{t 'auth.reset.intro'}}</mj-text>
    </mj-column>
  </mj-section>
  {{> button url=data.ctaUrl label=(t 'auth.reset.cta') color=brand.primaryColor showLink=true linkLabel=(t 'common.pasteLink')}}
  {{> infobox text=(t 'auth.reset.note')}}
{{/layout}}
