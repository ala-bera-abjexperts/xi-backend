{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": false,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "incremental": false,
    "types": ["node", "jest"]
  }
}
