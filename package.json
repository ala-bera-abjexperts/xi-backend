{
  "name": "xisuite-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_OPTIONS=--max-old-space-size=4096 nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:tm-runner": "NODE_ENV=production TM_RUNNER_WORKER=1 node dist/test-automation-runner/runner.worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "dev:cron": "node scripts/local-cron.mjs",
    "dev:workflow-cron": "WORKFLOW_CRON_WORKER=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' node -r ts-node/register src/workflow-cron/workflow-cron.worker.ts",
    "dev:tm-runner": "TM_RUNNER_WORKER=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' node -r ts-node/register src/test-automation-runner/runner.worker.ts",
    "file-explorer:repair-storage": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' node -r ts-node/register src/file-explorer/file-explorer-storage-repair.worker.ts",
    "email:preview": "node scripts/preview-emails.mjs"
  },
  "dependencies": {
    "@cucumber/gherkin": "39.1.0",
    "@cucumber/messages": "32.3.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@node-saml/node-saml": "5.1.0",
    "@supabase/supabase-js": "2.109.0",
    "@types/compression": "^1.8.1",
    "@xmldom/xmldom": "0.8.15",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "check-disk-space": "^3.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jexl": "^2.3.0",
    "jose": "^6.2.2",
    "jsdom": "^28.1.0",
    "jszip": "3.10.1",
    "mjml": "^4.15.3",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "6.4.299",
    "prom-client": "15.1.3",
    "puppeteer": "^25.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2-sftp-client": "^12.1.1",
    "stripe": "^22.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jexl": "^2.3.4",
    "@types/mjml": "^4.7.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/supertest": "^7.0.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "mjs",
      "cjs",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.mjs$": "<rootDir>/../test/mjs-transformer.js",
      "^.+\\.[cm]?[jt]sx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "./test/jest-setup.ts"
    ],
    "workerIdleMemoryLimit": "384MB",
    "maxWorkers": "50%"
  },
  "pnpm": {
    "overrides": {
      "lodash@>=4.0.0 <4.18.1": "4.18.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "proxy-addr@<2.0.8": "2.0.8",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "multer@>=2.0.0 <2.5.0": "2.5.0",
      "source-map-js@<1.2.2": "1.2.2",
      "qs@>=6.0.0 <6.16.1": "6.16.1"
    }
  }
}
