<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven ignores the usual proxy options, so each run's proxy host is read from what the runner passes in. Maven can't read a port from a variable. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <proxies>
    <proxy>
      <id>run-proxy-https</id>
      <active>true</active>
      <protocol>https</protocol>
      <host>${env.XISUITE_PROXY_HOST}</host>
      <port>8888</port>
    </proxy>
    <proxy>
      <id>run-proxy-http</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>${env.XISUITE_PROXY_HOST}</host>
      <port>8888</port>
    </proxy>
  </proxies>
</settings>
