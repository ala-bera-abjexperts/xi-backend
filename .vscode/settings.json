{
  "typescript.tsdk": "node_modules/.pnpm/typescript@5.9.3/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.workingDirectories": ["."],
  "eslint.options": {
    "overrideConfigFile": "eslint.config.mjs"
  },
